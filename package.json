{
  "name": "taiba-smart-lab",
  "version": "1.0.2",
  "private": true,
  "description": "Taiba Smart Lab Windows desktop shell",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/electron-contract.test.mjs",
    "check:electron": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check scripts/generate-icons.cjs",
    "build:icons": "node scripts/generate-icons.cjs",
    "build:win": "npm run check:electron && npm test && npm run build:icons && electron-builder --win nsis --x64 --publish never",
    "release:win": "npm run check:electron && npm test && npm run build:icons && electron-builder --win nsis --x64 --publish always"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.34.5",
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "com.taibatech.smartlab",
    "productName": "Taiba Smart Lab",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!baseline/**/*",
      "!node_modules/.cache/**/*",
      "!tests/**/*",
      "!docs/**/*",
      "!*.md",
      "!*.yml",
      "!*.yaml"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/taiba.ico",
      "artifactName": "Taiba-Smart-Lab-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Taiba Smart Lab",
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "teba-labs",
        "repo": "teba-saas-demo",
        "releaseType": "release"
      }
    ]
  }
}
